# Copy to `.env.local` (dev) or `.env` (self-hosted) and fill in what you need.
# Next.js loads both automatically. Everything here is optional; the app falls
# back to the per-visitor key prompt when MUAPI_API_KEY is unset.
# Full reference: docs/SETUP.md

# Server-side Muapi key. When set, the server attaches it to outbound API calls
# for visitors who have not supplied their own key, and the key prompt is
# skipped. The value never reaches the browser.
# Get one at https://muapi.ai/access-keys
#MUAPI_API_KEY=

# Upstream base URL for Muapi calls. Point at a Muapi-compatible gateway,
# regional mirror, or staging endpoint. Unset uses https://api.muapi.ai
#MUAPI_BASE_URL=

# Opt IN to blocking cross-origin requests to the dev server's /_next/* assets.
#
# WARNING: leave this unset for normal development. Defining it moves Next's dev
# server from "warn" to "block" mode, and its cross-site subresource branch
# ignores this list entirely - so any value here returns 403 for the app's own
# JavaScript when the page is embedded in a cross-site preview pane, tunnel, or
# IDE browser, and the page renders blank. It is only useful when you want that
# blocking on purpose (e.g. exposing the dev server on a shared network).
#OGA_ALLOWED_DEV_ORIGINS=

# Who may embed the app in an iframe (CSP frame-ancestors). Defaults to 'none'
# in production and '*' in development.
#OGA_FRAME_ANCESTORS=

# Where the desktop app keeps the sd.cpp engine and model weights (multi-GB).
#OPEN_GENERATIVE_AI_LOCAL_AI_DIR=
